---
import PostCard from "@/components/blog/PostCard.astro";
import Footer from "@/components/Footer.svelte";
import Navbar from "@/components/Navbar.svelte";
import Layout from "@/layouts/Layout.astro";
import { formatDate, getPosts, readingTime, type BlogPost } from "@/lib/blog";
import "@/styles/blog.css";
import { getImage, Image } from "astro:assets";
import { render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      more: [1, 2, 3]
        .map((offset) => posts[(index + offset) % posts.length])
        .filter((p) => p.id !== post.id)
        .filter((p, i, all) => all.findIndex((o) => o.id === p.id) === i),
    },
  }));
}

interface Props {
  post: BlogPost;
  more: BlogPost[];
}

const { post, more } = Astro.props;
const { title, description, date, author, image, imageAlt, tags } = post.data;
const { Content } = await render(post);
const minutes = readingTime(post.body);

const ogImage = image
  ? (
      await getImage({
        src: image,
        inferSize: typeof image === "string",
        width: 1200,
        format: "png",
      })
    ).src
  : undefined;
---

<Layout title={title} description={description} image={ogImage} type="article">
  <Navbar slot="navbar" client:load />
  <div class="blog-progress" aria-hidden="true"></div>

  <article class="pb-24">
    <div class="mx-auto max-w-6xl px-4 pt-8 sm:px-6 lg:px-8">
      {
        image && (
          <div class="blog-hero">
            <Image
              src={image}
              inferSize={typeof image === "string"}
              alt={imageAlt ?? ""}
              widths={[640, 960, 1280, 1920]}
              sizes="(min-width: 1152px) 1152px, 100vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )
      }

      <header
        class:list={[
          "blog-header-card p-6 sm:p-10",
          image ? "-mt-6 sm:-mt-10 lg:-mt-12" : "mt-8",
        ]}
      >
        <a href="/blog" class="blog-back-link">
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            aria-hidden="true"
            ><path
              d="M19 12H5M11 18l-6-6 6-6"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
          All posts
        </a>
        {
          tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="blog-tag">{tag}</span>
              ))}
            </div>
          )
        }
        <h1
          class="mt-4 font-semibold text-4xl text-white tracking-tight sm:text-5xl"
        >
          {title}
        </h1>
        <p class="mt-4 text-lg text-neutral-300">{description}</p>
        <div
          class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-neutral-400"
        >
          <span class="font-medium text-neutral-100">{author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
        </div>
      </header>
    </div>

    <div class="prose-blog mx-auto mt-14 max-w-3xl px-4 sm:px-6">
      <Content />
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="border-neutral-800 border-t">
        <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
          <h2 class="mb-8 font-semibold text-2xl text-white tracking-tight">
            Keep reading
          </h2>
          <div class="flex flex-col gap-6">
            {more.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Footer slot="footer" client:idle />
</Layout>

<script>
  const bar = document.querySelector<HTMLElement>(".blog-progress");
  const article = document.querySelector<HTMLElement>("article");
  if (bar && article) {
    const update = () => {
      const { top, height } = article.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, -top / (height - innerHeight)));
      bar.style.setProperty("--progress", String(progress));
    };
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
    update();
  }
</script>
